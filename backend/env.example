# Copy to .env and fill in your real values
# Never commit .env to git

# Postgres — matches docker-compose.yml defaults
DATABASE_URL=postgresql://postgres:password@localhost:5432/streamvault

# Cloudflare R2
# Find these in: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
R2_S3_API=https://your_account_id.r2.cloudflarestorage.com
R2_TOKEN_VALUE=your_r2_token_value

# Public URL of this API
# Local: http://localhost:8079
# Production: https://your-railway-app.up.railway.app
PUBLIC_URL=http://localhost:8079

PORT=8079